{
  "name": "daad-blockly",
  "version": "1.0.0",
  "description": "لغة ضاد - Desktop Blockly App",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "dist": "electron-builder",
    "dist:linux": "electron-builder --linux",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac"
  },
  "build": {
    "appId": "com.daad.blockly",
    "productName": "لغة ضاد",
    "directories": {
      "output": "dist"
    },
    "files": [
      "index.html",
      "main.js",
      "preload.js",
      "renderer.js",
      "assets/**/*",
      "bin/**/*",
      "node_modules/**/*"
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Education",
      "icon": "assets/icons"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "assets/icons/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "assets/icons/512.png",
      "category": "public.app-category.education"
    }
  },
  "dependencies": {
    "blockly": "^13.0.0",
    "electron": "^42.4.1"
  },
  "devDependencies": {
    "electron-builder": "^26.15.3",
    "eslint": "^8.57.1",
    "jsdom": "^27.4.0",
    "vitest": "^2.1.9"
  }
}
